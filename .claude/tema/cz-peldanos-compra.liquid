{%- comment -%}
  Ficha de Peldaños — piezas que van DENTRO de la columna de compra del main-product, cada
  una en su bloque «Liquid personalizado» de la plantilla product.peldanos-v2:
    {% render 'cz-peldanos-compra', product: product, parte: 'eyebrow' %}   arriba de todo: CSS + eyebrow + H1
    {% render 'cz-peldanos-compra', product: product, parte: 'resumen' %}   precio «desde» + ficha en líneas
    {% render 'cz-peldanos-compra', product: product, parte: 'selector' %}  antes del selector de variantes
    {% render 'cz-peldanos-compra', product: product, parte: 'despues' %}   después del recuadro de envío

  30-10-2026: rediseño aprobado en boceto (Playfair en títulos, líneas finas en vez de
  tarjetas, todo a la izquierda, un solo verde de marca). El H1 va acá y el bloque «título»
  del tema queda apagado en la plantilla: así el nombre del producto (carrito, Google Shopping)
  no cambia. NUNCA «madera nativa»: no todas lo son; se dice «madera noble».

  El selector NO reemplaza el formulario del tema: mueve los <select> de variantes y el
  input de cantidad de Dawn y dispara su evento «change», así el precio, el carrito y el
  recuadro de envío (cz-envio) siguen funcionando igual que siempre. Si algo no calza
  (otro tema, opciones renombradas) el selector se esconde y quedan los controles del tema.

  Datos reales que lo justifican (cotizador, 196 cotizaciones de peldaños al 28-10-2026):
  mediana de 13 peldaños por escalera; solo 91 de 200 medidas tienen fondo de 25-30 cm.
{%- endcomment -%}
{%- liquid
  assign parte = parte | default: 'selector'
  assign cant_base = 13
  assign wa_web = '56956375558'
  for o in product.options_with_values
    if o.name == 'Tipo de madera'
      assign opt_m = o
      assign idx_m = forloop.index0
    endif
    if o.name == 'Medidas'
      assign opt_a = o
      assign idx_a = forloop.index0
    endif
  endfor
-%}

{%- if parte == 'eyebrow' -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400&display=swap" rel="stylesheet">
<style>
  .czp{--tinta:#1F1D24;--sec:#57524B;--linea:#E4DDD2;--borde:#948A7C;--papel:#FBF9F6;--verde:#485B3D;--terra:#B5652E;--terra-tx:#9A5224;color:var(--tinta);font-size:15px;line-height:1.6}
  .czp-serif,.czp h1,.czp-m .n,.czp-med h3{font-family:'Playfair Display',Georgia,serif;font-weight:400}
  .czp .num{font-variant-numeric:tabular-nums}
  .czp-eb{font-size:11px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:var(--sec);margin:4px 0 0}
  .czp h1{font-size:40px;line-height:1.08;letter-spacing:-.015em;margin:10px 0 14px;color:var(--tinta)}
  @media (min-width:990px){.czp h1{font-size:52px}}
  .czp-precio{font-size:15px;color:var(--sec);margin:0}
  .czp-precio b{color:var(--tinta);font-weight:600}
  .czp-spec{margin:24px 0 0;border-top:1px solid var(--linea)}
  .czp-spec div{display:grid;grid-template-columns:104px 1fr;gap:12px;padding:12px 0;border-bottom:1px solid var(--linea)}
  .czp-spec dt{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--sec);padding-top:2px}
  .czp-spec dd{margin:0;font-size:15px;line-height:1.45}

  .czp-sel{padding-top:36px}
  .czp-tabs{display:flex;gap:24px;border-bottom:1px solid var(--linea)}
  .czp-tabs>*{padding:0 0 10px;font-size:15px;color:var(--sec);text-decoration:none;min-height:44px;display:flex;align-items:flex-end}
  .czp-tabs .on{color:var(--tinta);font-weight:500;box-shadow:inset 0 -2px 0 var(--tinta)}
  .czp-tabs a:hover{color:var(--tinta)}
  .czp-lbl{display:flex;justify-content:space-between;align-items:baseline;gap:8px;margin:26px 0 6px}
  .czp-lbl b{font-size:12px;font-weight:500;letter-spacing:.08em;text-transform:uppercase}
  .czp-lbl span{font-size:13px;color:var(--sec)}
  .czp-mad{border-top:1px solid var(--linea)}
  /* fila de madera: un <button> por madera (las cuatro alineadas igual, sin tarjetas) */
  .czp-m{display:grid;grid-template-columns:56px 1fr auto;gap:14px;align-items:center;width:100%;padding:12px 0;border:0;border-bottom:1px solid var(--linea);background:none;font:inherit;color:inherit;text-align:left;cursor:pointer;position:relative}
  .czp-m img{width:56px;height:56px;object-fit:cover;border-radius:2px;display:block}
  .czp-m .n{display:block;font-size:20px;line-height:1.2}
  .czp-m .d{display:block;font-size:13px;color:var(--sec);line-height:1.4}
  .czp-m .p{font-size:14px;text-align:right;white-space:nowrap}
  .czp-m .p small{display:block;font-size:11px;color:var(--sec)}
  .czp-m .rec{font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--terra-tx);display:block;margin-top:2px}
  .czp-m.on{box-shadow:inset 3px 0 0 var(--verde);padding-left:14px;background:var(--papel)}
  .czp-m:focus-visible,.czp-chips button:focus-visible,.czp-step button:focus-visible{outline:2px solid var(--verde);outline-offset:2px}
  .czp-chips{display:flex;flex-wrap:wrap;gap:8px}
  .czp-chips button{min-width:62px;height:44px;padding:0 10px;border:1px solid var(--borde);border-radius:4px;background:#fff;font:inherit;font-size:15px;color:var(--tinta);cursor:pointer;font-variant-numeric:tabular-nums}
  .czp-chips button.on{background:var(--tinta);border-color:var(--tinta);color:#fff}
  .czp-cant{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:26px;padding:16px 0;border-top:1px solid var(--linea);border-bottom:1px solid var(--linea)}
  .czp-cant .q{font-size:13px;color:var(--sec);line-height:1.35}
  .czp-step{display:flex;align-items:center;border:1px solid var(--borde);border-radius:4px}
  .czp-step button{width:44px;height:44px;border:0;background:none;font-size:20px;line-height:1;color:var(--tinta);cursor:pointer}
  .czp-step output{width:44px;text-align:center;font-size:17px;font-weight:500;font-variant-numeric:tabular-nums}
  .czp-tot{display:flex;justify-content:space-between;align-items:baseline;gap:10px;margin:18px 0 4px}
  .czp-tot b{font-size:30px;font-weight:500;letter-spacing:-.01em;font-variant-numeric:tabular-nums}
  .czp-cuo{font-size:13px;color:var(--sec);text-align:right;margin:0;font-variant-numeric:tabular-nums}
  .czp-links{display:flex;flex-wrap:wrap;gap:4px 22px;margin-top:6px;font-size:14px}
  .czp-links a{color:var(--tinta);text-decoration:underline;text-underline-offset:3px;text-decoration-color:var(--borde);min-height:44px;display:inline-flex;align-items:center}
  .czp-med{margin-top:40px}
  .czp-med h3{font-size:24px;line-height:1.2;margin:0 0 8px;letter-spacing:0;color:var(--tinta)}
  .czp-med p{margin:0;color:var(--sec)}
  .czp-btn2{display:flex;align-items:center;justify-content:center;min-height:48px;border:1px solid var(--tinta);border-radius:4px;font-weight:500;font-size:15px;margin-top:14px;color:var(--tinta);text-decoration:none;background:#fff}
  .czp-btn2:hover{background:var(--tinta);color:#fff}

  /* Piezas del tema que esta ficha reemplaza (solo en esta plantilla: el CSS vive acá) */
  product-info [id^="price-template"]{display:none!important}
  /* el bloque «payment» se queda encendido: de él cuelga el recuadro de envío (cz-envio) */
  product-info .footer__payment{display:none!important}
  .czp-ok variant-selects,.czp-ok .product-form__quantity{display:none!important}
  product-info .product-form__submit{background:var(--verde,#485B3D)!important;border-radius:4px!important;min-height:52px;font-weight:500;font-size:16px;margin-top:18px}
  product-info .product-form__submit:before,product-info .product-form__submit:after{border-radius:4px!important;box-shadow:none!important}
  product-info .czenv{background:none;border:0;border-top:1px solid #E4DDD2;border-bottom:1px solid #E4DDD2;border-radius:0;padding:14px 0;margin:18px 0 0}
  product-info .czenv__t{color:#1F1D24;font-weight:500}
  .product__info-wrapper{border:0!important}
  @media (max-width:749px){
    /* margen de 20 px a cada lado, como en el boceto (el tema dejaba 25 con un borde) */
    .product__info-wrapper{padding-left:6px!important;padding-right:6px!important}
    .czp-chips{gap:6px}
    .czp-chips button{flex:1 1 0;min-width:0;padding:0 2px}
    /* foto a todo el ancho del celular */
    .product__media-list .product__media-item{margin-left:0!important;width:100%!important}
    .product__media-list .product-media-container{width:100%!important;max-width:100%!important}
    .product__media-list .product__media{padding-top:0!important;height:min(440px,113vw)}
  }
</style>
<div class="czp">
  <p class="czp-eb">Madera noble del sur · Villarrica</p>
  <h1>Peldaños de madera noble, a tu medida</h1>
</div>
{%- endif -%}

{%- if parte == 'resumen' -%}
  {%- assign desde = product.price_min | times: cant_base -%}
<div class="czp">
  <p class="czp-precio num">Desde <b>${{ product.price_min | money_without_currency | remove: '.00' | replace: ',', '.' }}</b> el peldaño. Una escalera de {{ cant_base }}, desde <b>${{ desde | money_without_currency | remove: '.00' | replace: ',', '.' }}</b>.</p>
  <dl class="czp-spec">
    <div><dt>Espesor</dt><dd>4 cm de madera maciza, sin enchapado</dd></div>
    <div><dt>Terminación</dt><dd>Llegan terminados, no tienes que barnizar</dd></div>
    <div><dt>Plazo</dt><dd class="num">7 a 15 días hábiles de fabricación</dd></div>
    <div><dt>Garantía</dt><dd>5 años. Si llegan con daño, los reponemos</dd></div>
  </dl>
</div>
{%- endif -%}

{%- if parte == 'selector' and opt_m and opt_a -%}
<div class="czp czp-sel" data-czp hidden>
  <div class="czp-tabs">
    <span class="on">Medida estándar</span>
    <a href="https://cotizador.casazaru.cl/?prod=peldanos" target="_blank" rel="noopener">A tu medida</a>
  </div>

  <div class="czp-lbl"><b>Madera</b><span data-czp-madn></span></div>
  <div class="czp-mad">
    {%- for w in opt_m.values -%}
      {%- liquid
        assign pmin = 0
        for v in product.variants
          if v.options[idx_m] == w
            if pmin == 0 or v.price < pmin
              assign pmin = v.price
            endif
          endif
        endfor
        case w
          when 'Castaño'
            assign d = 'Veta grande, dorado miel'
            assign img = 'https://cdn.shopify.com/s/files/1/0800/2283/1138/files/63996d4c-c673-4f40-96bf-5e93575358fd_1.jpg?v=1778022268&width=160'
          when 'Coihue'
            assign d = 'La más dura que trabajamos'
            assign img = 'https://cdn.shopify.com/s/files/1/0800/2283/1138/files/dfa122a9-8e49-4afb-a7a0-b3a0d22d887c.jpg?v=1779452067&width=160'
          when 'Raulí'
            assign d = 'Veta rojiza y profunda'
            assign img = 'https://cdn.shopify.com/s/files/1/0800/2283/1138/files/RAUL.jpg?v=1785500758&width=160'
          when 'Lenga'
            assign d = 'Veta fina, tonos suaves'
            assign img = 'https://cdn.shopify.com/s/files/1/0800/2283/1138/files/IMG-20260206-WA0056.jpg?v=1778020745&width=160'
          when 'Mañío'
            assign d = 'Textura fina y pareja'
            assign img = ''
          else
            assign d = ''
            assign img = ''
        endcase
      -%}
      <button type="button" class="czp-m" data-v="{{ w | escape }}">
        {%- if img != blank -%}<img src="{{ img }}" alt="Madera de {{ w | escape }}" width="56" height="56" loading="lazy">{%- else -%}<span></span>{%- endif -%}
        <span><span class="n">{{ w }}</span><span class="d">{{ d }}</span>{%- if w == 'Castaño' -%}<span class="rec">Recomendada para escaleras</span>{%- endif -%}</span>
        <span class="p num">${{ pmin | money_without_currency | remove: '.00' | replace: ',', '.' }}<small>desde</small></span>
      </button>
    {%- endfor -%}
  </div>

  <div class="czp-lbl"><b>Largo</b><span>fondo 30 cm · espesor 4 cm</span></div>
  <div class="czp-chips">
    {%- for a in opt_a.values -%}
      <button type="button" data-v="{{ a | escape }}">{{ a | split: ' x ' | first }} cm</button>
    {%- endfor -%}
  </div>

  <div class="czp-cant">
    <div class="q">Cuántos peldaños<br>cuenta los escalones</div>
    <div class="czp-step">
      <button type="button" data-czp-q="-1" aria-label="Un peldaño menos">−</button>
      <output data-czp-cant>{{ cant_base }}</output>
      <button type="button" data-czp-q="1" aria-label="Un peldaño más">+</button>
    </div>
  </div>
  <div class="czp-tot"><span>Total de tu escalera</span><b data-czp-total></b></div>
  <p class="czp-cuo" data-czp-cuotas></p>
  <script type="application/json" data-czp-variantes>{{ product.variants | json }}</script>
</div>
<script>
/* Corre cuando la página terminó de cargar: este bloque va ANTES del selector de variantes
   y de la cantidad del tema, así que al leer el script todavía no existen. */
(function (init) {
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})(function () {
  var root = document.querySelector('[data-czp]');
  if (!root) return;
  var IM = {{ idx_m }}, IA = {{ idx_a }};
  /* Dawn redibuja partes del formulario al cambiar de variante (la cantidad vuelve a 1):
     por eso los controles se buscan de nuevo cada vez y la cantidad elegida se guarda acá. */
  function info() { return root.closest('product-info') || document.querySelector('product-info') || document; }
  function selM() { return info().querySelector('select[name="options[{{ opt_m.name }}]"]'); }
  function selA() { return info().querySelector('select[name="options[{{ opt_a.name }}]"]'); }
  function qty() { return info().querySelector('input[name="quantity"]'); }
  if (!selM() || !selA() || !qty()) return;    /* sin los controles del tema: se queda lo de siempre */
  var vars;
  try { vars = JSON.parse(root.querySelector('[data-czp-variantes]').textContent); } catch (e) { return; }
  var n = parseInt(qty().value, 10) > 1 ? parseInt(qty().value, 10) : {{ cant_base }};

  function pesos(c) { return '$' + Math.round(c / 100).toLocaleString('es-CL'); }
  function poner(sel, txt) { var e = root.querySelector(sel); if (e && e.textContent !== String(txt)) e.textContent = txt; }
  function variante() {
    var m = selM().value, a = selA().value;
    for (var i = 0; i < vars.length; i++) {
      if (vars[i].options[IM] === m && vars[i].options[IA] === a) return vars[i];
    }
    return null;
  }
  function pintar() {
    var q = qty(), m = selM(), a = selA();
    if (!q || !m || !a) return;
    if (parseInt(q.value, 10) !== n) {           /* el tema la reseteó: se repone la elegida */
      q.value = n;
      q.dispatchEvent(new Event('change', { bubbles: true }));
    }
    root.querySelectorAll('.czp-m').forEach(function (b) {
      var on = b.dataset.v === m.value;
      b.classList.toggle('on', on);
      b.setAttribute('aria-pressed', on);
    });
    root.querySelectorAll('.czp-chips button').forEach(function (b) {
      var on = b.dataset.v === a.value;
      b.classList.toggle('on', on);
      b.setAttribute('aria-pressed', on);
    });
    poner('[data-czp-madn]', m.value);
    poner('[data-czp-cant]', n);
    var v = variante();
    if (!v) return;
    var t = v.price * n;
    poner('[data-czp-total]', pesos(t));
    poner('[data-czp-cuotas]', 'o 3 cuotas sin interés de ' + pesos(Math.floor(t / 3 / 100) * 100));
    var comp = document.querySelector('[data-czp-compartir]');
    if (comp) {
      var txt = 'Peldaños Casa Zaru: ' + n + ' de ' + v.options[IM] + ', ' + v.options[IA] + ', 4 cm macizos.\n\n' +
                'Total ' + pesos(t) + ' + envío.\n\n' + location.origin + location.pathname + '?variant=' + v.id;
      comp.href = 'https://wa.me/?text=' + encodeURIComponent(txt);
    }
  }
  function elegir(sel, val) {
    if (!sel || sel.value === val) return;
    sel.value = val;
    sel.dispatchEvent(new Event('change', { bubbles: true }));
  }

  root.querySelectorAll('.czp-m').forEach(function (b) { b.addEventListener('click', function () { elegir(selM(), b.dataset.v); pintar(); }); });
  root.querySelectorAll('.czp-chips button').forEach(function (b) { b.addEventListener('click', function () { elegir(selA(), b.dataset.v); pintar(); }); });
  root.querySelectorAll('[data-czp-q]').forEach(function (b) {
    b.addEventListener('click', function () { n = Math.max(1, Math.min(99, n + Number(b.dataset.czpQ))); pintar(); });
  });
  document.addEventListener('change', function () { setTimeout(pintar, 80); });
  /* cuando el tema termina de redibujar (llega por fetch, sin evento «change») */
  var espera;
  new MutationObserver(function () { clearTimeout(espera); espera = setTimeout(pintar, 120); })
    .observe(info(), { childList: true, subtree: true });

  root.hidden = false;
  if (info().classList) info().classList.add('czp-ok');
  pintar();
});
</script>
{%- endif -%}

{%- if parte == 'despues' -%}
<div class="czp">
  <div class="czp-links">
    <a href="https://wa.me/{{ wa_web }}?text={{ 'Hola, quiero ayuda para elegir peldaños.' | url_encode }}" target="_blank" rel="noopener">Hablar por WhatsApp</a>
    <a href="https://wa.me/?text={{ 'Peldaños Casa Zaru: ' | append: shop.url | append: product.url | url_encode }}" target="_blank" rel="noopener" data-czp-compartir>Compartir este total</a>
  </div>
  <div class="czp-med">
    <h3>¿Otro fondo, largos distintos o revestir hormigón?</h3>
    <p>En el cotizador pones cada peldaño con su medida, en 2 o 4 cm, con o sin contrahuella. El precio sale al instante.</p>
    <a class="czp-btn2" href="https://cotizador.casazaru.cl/?prod=peldanos" target="_blank" rel="noopener">Cotizar a mi medida</a>
  </div>
</div>
{%- endif -%}
