{%- comment -%}
  Bloque «CZ · Pasos cubierta» (blocks/cz-pasos-cubierta.liquid), en la portada de casazaru.cl,
  dentro de la sección _blocks 17781878041e0b98c8 de templates/index.json, en el lugar del bloque
  generado por IA ai_gen_block_cdfd7be_cakhTq («Pasos para tener tu cubierta»), que queda
  APAGADO ahí mismo: volver atrás = encenderlo y sacar este de block_order.
  Boceto B aprobado el 03-11-2026: un sendero de puntos de «Empieza aquí» a «Tu casa», con las
  5 paradas a lado y lado en el celular y en una fila en PC. Íconos de línea café, sin emojis.
  Textos: «7 a 15 días hábiles»; retiro en el taller sin decir que es gratis (no confirmado).
  #AA5820 para texto chico y botón: el naranjo #ce6718 de la web no da contraste AA.
{%- endcomment -%}
{%- assign wa_web = '56956375558' -%}
<style>
  .czr{--tinta:#1e1c1c;--sec:#5a5050;--cafe:#6b3410;--naranja:#AA5820;color:var(--tinta);font-family:var(--font-body-family),Poppins,sans-serif;max-width:1200px;margin:0 auto;padding:40px 20px 44px}
  .czr *{box-sizing:border-box}
  /* En celular y tablet todo va en una columna de 400 px como máximo: los tramos del sendero
     son SVG que se estiran, y más ancho que eso los puntos ya no caen en el centro de cada nodo */
  .czr-cab{max-width:400px;margin:0 auto}
  .czr-eb{font-size:12px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--naranja);margin:0}
  .czr h2{font-family:inherit;font-size:28px;line-height:1.15;font-weight:600;margin:8px 0 0;letter-spacing:-.01em;color:var(--tinta)}
  .czr-baj{font-size:15px;line-height:1.5;color:var(--sec);margin:8px 0 0}

  /* 03-11: el usuario lo encontró largo en el celular. Nodos de 56 px, tramos de 28 px y una
     línea de texto por paso; en PC se mantienen los nodos de 72 px */
  .czr-ruta{list-style:none;margin:22px auto 0;padding:0;max-width:400px}
  .czr-hito{display:flex;align-items:center;gap:10px;font-size:12px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--sec)}
  .czr-hito.fin{justify-content:flex-end}
  .czr-hito svg{width:26px;height:26px;flex:0 0 auto}
  .czr svg{stroke:var(--cafe);fill:none;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
  .czr-tramo{display:block}
  .czr-tramo svg{display:block;width:100%;height:28px;stroke-width:2.2;stroke-dasharray:0 8}

  .czr-par{display:grid;grid-template-columns:56px 1fr;column-gap:14px;align-items:center}
  .czr-par.der{grid-template-columns:1fr 56px}
  .czr-par.der .czr-nodo{order:2}
  .czr-nodo{position:relative;width:56px;height:56px;border-radius:50%;background:#fff;border:1.5px solid var(--cafe);display:flex;align-items:center;justify-content:center}
  .czr-nodo svg{width:36px;height:36px}
  .czr-n{position:absolute;bottom:-6px;left:50%;transform:translateX(-50%);min-width:20px;height:20px;padding:0 5px;border-radius:10px;background:var(--naranja);color:#fff;font-size:11px;font-weight:600;display:flex;align-items:center;justify-content:center}
  .czr-meta{font-size:11px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--naranja);font-variant-numeric:tabular-nums}
  .czr-meta span{color:var(--sec)}
  .czr h3{font-family:inherit;font-size:17px;font-weight:600;margin:2px 0;line-height:1.25;color:var(--tinta)}
  .czr-par p{margin:0;font-size:14px;line-height:1.45;color:var(--sec);text-wrap:pretty}

  .czr-acc{max-width:400px;margin:22px auto 0}
  .czr-btn{display:flex;align-items:center;justify-content:center;min-height:52px;background:var(--naranja);color:#fff;border-radius:4px;font-weight:500;font-size:16px;text-decoration:none}
  .czr-btn:hover{background:#8F4A1F;color:#fff}
  .czr-ayu{margin:14px 0 0;font-size:13px;color:var(--sec)}
  .czr-ayu a{color:var(--tinta);text-decoration:underline;text-underline-offset:3px}

  /* PC: las 5 paradas en una fila sobre un solo sendero de puntos */
  @media (min-width:990px){
    .czr{padding:96px 40px}
    .czr-cab{max-width:none;margin:0}
    .czr-baj{margin-top:10px}
    .czr h2{font-size:40px}
    .czr-ruta{max-width:none;margin-top:48px;display:grid;grid-template-columns:92px repeat(5,1fr) 92px;column-gap:28px;position:relative}
    /* el sendero corre entre el alfiler y la casa; los nodos blancos lo tapan */
    .czr-ruta:before{content:'';position:absolute;left:80px;right:80px;top:35px;height:3px;background:radial-gradient(circle,var(--cafe) 1.1px,transparent 1.6px) left center/9px 3px repeat-x}
    .czr-tramo{display:none}
    .czr-hito{flex-direction:column;justify-content:flex-start;align-items:center;gap:6px;padding-top:21px;font-size:11px;text-align:center}
    .czr-hito.fin{justify-content:flex-start}
    .czr-hito.fin svg{order:-1}
    .czr-par,.czr-par.der{display:block;position:relative}
    .czr-nodo{width:72px;height:72px;margin-bottom:22px}
    .czr-nodo svg{width:46px;height:46px}
    .czr-n{min-width:24px;height:24px;border-radius:12px;font-size:12px}
    .czr-hito svg{width:30px;height:30px}
    .czr h3{font-size:19px;margin:4px 0}
    .czr-par p{font-size:14.5px;line-height:1.55}
    .czr-acc{max-width:420px;margin:44px 0 0}
  }
  @media (prefers-reduced-motion:reduce){.czr-btn{transition:none}}
</style>

