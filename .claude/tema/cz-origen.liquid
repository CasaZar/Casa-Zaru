{%- comment -%}
  cz-origen (05-11-2026): recuerda de qué anuncio llegó el visitante, para que el
  cotizador (cotizador.casazaru.cl) lo guarde en la cotización. Antes se perdía: el
  link «Cotizar» de la tienda no lleva los parámetros del anuncio y el 71 % de las
  cotizaciones públicas llega desde acá.
  Solo escribe cuando la URL trae un anuncio (utm_*, gclid, gbraid, wbraid, fbclid):
  el último anuncio gana, 90 días, en una cookie del dominio .casazaru.cl que el
  subdominio del cotizador puede leer. No se muestra nada en la página.
  Se renderiza en layout/theme.liquid, antes de </head>.
{%- endcomment -%}
<script>
(function () {
  try {
    var p = new URLSearchParams(location.search), o = {}, hay = false;
    ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term', 'gclid', 'gbraid', 'wbraid', 'fbclid'].forEach(function (k) {
      var v = p.get(k);
      if (v) { o[k] = String(v).slice(0, 150); hay = true; }
    });
    if (!hay) return;
    o.fecha = new Date().toISOString();
    o.pag = location.pathname.slice(0, 80);
    var dom = /(^|\.)casazaru\.cl$/.test(location.hostname) ? '; domain=.casazaru.cl' : '';
    document.cookie = 'cz_origen=' + encodeURIComponent(JSON.stringify(o)) + dom +
      '; path=/; max-age=' + (90 * 86400) + '; SameSite=Lax; Secure';
  } catch (e) {}
})();
</script>
