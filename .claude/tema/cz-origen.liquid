{%- comment -%}
  Origen del anuncio hacia el cotizador (28-10-2026).
  Los anuncios llevan a casazaru.cl y el link al cotizador perdía el gclid/UTM, así que
  ninguna cotización quedaba atribuida a Google. Este script guarda la marca del anuncio
  al entrar (90 días, igual que el cotizador) y se la agrega a todo link hacia
  cotizador.casazaru.cl, sin pisar los parámetros que el link ya trae (?prod=…).
  Si la visita no trae marca en la URL, usa la cookie de la etiqueta de Google (_gcl_aw / _gcl_gb).
  No muestra nada. Se renderiza una vez en layout/theme.liquid, antes de </body>.
  Las llaves son las mismas que lee origenCapturar() en el cotizador (ORIGEN_ANUNCIO).
{%- endcomment -%}
<script>
(function () {
  try {
    var LLAVES = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term', 'gclid', 'gbraid', 'wbraid', 'fbclid'];
    var LS = 'cz_origen', DIAS = 90, HOST = 'cotizador.casazaru.cl';

    var q = new URLSearchParams(location.search), nuevo = {}, hay = false;
    LLAVES.forEach(function (k) {
      var v = q.get(k);
      if (v) { nuevo[k] = String(v).slice(0, 300); hay = true; }
    });
    if (hay) {
      nuevo._t = Date.now();
      try { localStorage.setItem(LS, JSON.stringify(nuevo)); } catch (e) {}
    }

    function cookieGcl(nombre) {
      var m = document.cookie.match(new RegExp('(?:^|; )' + nombre + '=([^;]+)'));
      if (!m) return '';
      var p = decodeURIComponent(m[1]).split('.');
      return p.length >= 3 ? p.slice(2).join('.') : '';
    }

    function origen() {
      var g = null;
      try { g = JSON.parse(localStorage.getItem(LS) || 'null'); } catch (e) {}
      if (!g || !g._t || Date.now() - g._t > DIAS * 864e5) g = {};
      if (!g.gclid && !g.gbraid && !g.wbraid) {
        var aw = cookieGcl('_gcl_aw'), gb = cookieGcl('_gcl_gb');
        if (aw) g.gclid = aw; else if (gb) g.gbraid = gb;
      }
      return g;
    }

    function marcar(a) {
      if (!a || !a.href) return;
      var u;
      try { u = new URL(a.href, location.href); } catch (e) { return; }
      if (u.hostname !== HOST) return;
      var g = origen(), cambio = false;
      LLAVES.forEach(function (k) {
        if (g[k] && !u.searchParams.has(k)) { u.searchParams.set(k, g[k]); cambio = true; }
      });
      if (cambio) a.href = u.toString();
    }

    function marcarTodos() {
      document.querySelectorAll('a[href*="' + HOST + '"]').forEach(marcar);
    }

    // Al hacer clic (también links que el tema dibuja después de cargar).
    ['click', 'auxclick', 'contextmenu'].forEach(function (ev) {
      document.addEventListener(ev, function (e) {
        var a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
        if (a) marcar(a);
      }, true);
    });
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', marcarTodos);
    else marcarTodos();
  } catch (e) {}
})();
</script>
