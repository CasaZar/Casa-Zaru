                                                                                           }
                                                                          },
                                                 "custom_liquid_pHbKqc":  {
                                                                              "type":  "custom_liquid",
                                                                              "settings":  {
                                                                                               "custom_liquid":  "\u003cdiv class=\"product-description-expandable\"\u003e\n  {% if product.description %}\n    \u003cdiv class=\"description-content\" id=\"descriptionContent\"\u003e\n      {{ product.description }}\n    \u003c/div\u003e\n    \u003cbutton class=\"description-toggle\" id=\"toggleBtn\" onclick=\"toggleDescription()\"\u003eLeer más\u003c/button\u003e\n  {% endif %}\n\u003c/div\u003e\n\n\u003cstyle\u003e\n  .product-description-expandable {\n    margin: 20px 0;\n  }\n  \n  .description-content {\n    max-height: 180px;\n    overflow: hidden;\n    transition: max-height 0.3s ease-in-out;\n    line-height: 1.6;\n  }\n  \n  .description-content.expanded {\n    max-height: none;\n  }\n  \n  .description-toggle {\n    background: none;\n    border: none;\n    color: #3eab2d;\n    cursor: pointer;\n    font-weight: 600;\n    padding: 12px 0;\n    font-size: 16px;\n    text-decoration: underline;\n    transition: color 0.2s ease;\n  }\n  \n  .description-toggle:hover {\n    color: #2d8a21;\n  }\n\u003c/style\u003e\n\n\u003cscript\u003e\n  function toggleDescription() {\n    const content = document.getElementById(\u0027descriptionContent\u0027);\n    const btn = document.getElementById(\u0027toggleBtn\u0027);\n    \n    content.classList.toggle(\u0027expanded\u0027);\n    btn.textContent = content.classList.contains(\u0027expanded\u0027) ? \u0027Leer menos\u0027 : \u0027Leer más\u0027;\n  }\n\u003c/script\u003e"
                                                                                           }
                                                                          },
